{
    "name": "server",
    "version": "1.0.0",
    "description": "server for realtime inventory tracking software.",
    "keywords": [
        "inventory",
        "realtime",
        "tracking",
        "express.js",
        "backend",
        "server"
    ],
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "biome check",
        "format": "biome format --write",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "prisma": "^6.19.3",
        "socket.io": "^4.8.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
