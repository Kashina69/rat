PORT=5000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="mysql://rat:rat@localhost:3306/rat"
# Separate MySQL database used only by the Vitest suite (`npm test` in server/).
TEST_DATABASE_URL="mysql://rat:rat@localhost:3306/rat_test"
# JWT_SECRET: at least 32 characters of random data, e.g. `openssl rand -base64 48`.
# Short values and known placeholders (such as the value below) are rejected when
# NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Number of reverse-proxy hops in front of the API, used for the client IP
# (rate limiting, X-Forwarded-For). 0 = API is reachable directly, so forwarded
# headers are ignored. 1 = behind one load balancer / reverse proxy.
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:3000
# Production: comma-separated exact origins, no "*". Example:
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Demo seed passwords (required when seeding with NODE_ENV=production). Any value
# set also overrides the dev-only fallback password used in development.
# SEED_ADMIN_PASSWORD=
# SEED_GATE_PASSWORD=
# SEED_SHEDA_PASSWORD=
# SEED_SHEDB_PASSWORD=
# Set to 1 to allow `npm run db:seed -- --reset`, which deletes all rows, while
# NODE_ENV=production. Anything else refuses the reset.
# ALLOW_DESTRUCTIVE_SEED=1
